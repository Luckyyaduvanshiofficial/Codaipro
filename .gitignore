# ---------------------------------------------------------------------------
# Codai Pro (v3+) layout
# ---------------------------------------------------------------------------

# Parallel-development working copy (has its own .git)
Codaipro2.0/

# Engine binary is downloaded per-machine / fetched in CI
engine/

# Desktop (Electron) app
desktop/node_modules/
